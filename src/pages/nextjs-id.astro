---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Next.js Indonesia" description="10 template company profile Next.js Indonesia." template="nextjs-id" lang="id">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Next.js Indonesia</span>
      <h1>Next.js <span class="accent">Indonesia</span></h1>
      <p class="hero-description">10 template company profile dengan Next.js App Router. Bahasa Indonesia.</p>
      <a href="/" class="btn">← Kembali ke Home</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Template</span>
        <h2 class="section-title">Next.js Indonesia — 10 Desain</h2>
        <p class="section-description">Setiap template adalah halaman statis mandiri. Buka untuk preview, atau impor folder sumber ke Vercel.</p>
      </div>
      <div class="grid grid-cols-2">
        <div class="card">
          <span class="card-badge">01</span>
          <h3 class="card-title">Enterprise Authority</h3>
          <p class="card-text">Restrained, authoritative, accessible.</p>
        </div>
        <div class="card">
          <a href="/templates/enterprise-authority/nextjs-id/index.html" class="btn btn-accent" style="justify-content:flex-end;">Buka →</a>
        </div>
        <div class="card">
          <span class="card-badge">02</span>
          <h3 class="card-title">Deep Tech Frontier</h3>
          <p class="card-text">Dark, technical, data-dense.</p>
        </div>
        <div class="card">
          <a href="/templates/deep-tech-frontier/nextjs-id/index.html" class="btn btn-accent" style="justify-content:flex-end;">Buka →</a>
        </div>
        <div class="card">
          <span class="card-badge">03</span>
          <h3 class="card-title">UMKM Warmth</h3>
          <p class="card-text">Human, authentic, warm.</p>
        </div>
        <div class="card">
          <a href="/templates/umkm-warmth/nextjs-id/index.html" class="btn btn-accent" style="justify-content:flex-end;">Buka →</a>
        </div>
        <div class="card">
          <span class="card-badge">04</span>
          <h3 class="card-title">Creative Studio</h3>
          <p class="card-text">Portfolio-first, visual density.</p>
        </div>
        <div class="card">
          <a href="/templates/creative-studio/nextjs-id/index.html" class="btn btn-accent" style="justify-content:flex-end;">Buka →</a>
        </div>
        <div class="card">
          <span class="card-badge">05</span>
          <h3 class="card-title">SaaS Product-Led</h3>
          <p class="card-text">Demo-driven, developer-friendly.</p>
        </div>
        <div class="card">
          <a href="/templates/saas-product-led/nextjs-id/index.html" class="btn btn-accent" style="justify-content:flex-end;">Buka →</a>
        </div>
        <div class="card">
          <span class="card-badge">06</span>
          <h3 class="card-title">Innovation Lab</h3>
          <p class="card-text">Experimental, motion-heavy.</p>
        </div>
        <div class="card">
          <a href="/templates/innovation-lab/nextjs-id/index.html" class="btn btn-accent" style="justify-content:flex-end;">Buka →</a>
        </div>
        <div class="card">
          <span class="card-badge">07</span>
          <h3 class="card-title">Corporate Institutional</h3>
          <p class="card-text">Structured, compliant.</p>
        </div>
        <div class="card">
          <a href="/templates/corporate-institutional/nextjs-id/index.html" class="btn btn-accent" style="justify-content:flex-end;">Buka →</a>
        </div>
        <div class="card">
          <span class="card-badge">08</span>
          <h3 class="card-title">Mission Driven</h3>
          <p class="card-text">Story-led, evidence-based.</p>
        </div>
        <div class="card">
          <a href="/templates/mission-driven/nextjs-id/index.html" class="btn btn-accent" style="justify-content:flex-end;">Buka →</a>
        </div>
        <div class="card">
          <span class="card-badge">09</span>
          <h3 class="card-title">Developer Platform</h3>
          <p class="card-text">API-first, dark-native.</p>
        </div>
        <div class="card">
          <a href="/templates/developer-platform/nextjs-id/index.html" class="btn btn-accent" style="justify-content:flex-end;">Buka →</a>
        </div>
        <div class="card">
          <span class="card-badge">10</span>
          <h3 class="card-title">Modular Agency</h3>
          <p class="card-text">Component showcase, themeable.</p>
        </div>
        <div class="card">
          <a href="/templates/modular-agency/nextjs-id/index.html" class="btn btn-accent" style="justify-content:flex-end;">Buka →</a>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Design System · <a href="/" style="color: var(--color-ink-3);">Kembali ke Home</a></p>
  </footer>
</BaseLayout>