---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Bakery" description="Artisan bakery with sourdough bread and pastries." template="mafyn-bakery" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Artisan Bakery</span>
      <h1>Mafyn <span class="accent">Bakery</span></h1>
      <p class="hero-description">Sourdough bread, pastries, and cakes baked fresh daily in Jakarta.</p>
      <div class="hero-actions">
        <a href="#menu" class="btn btn-accent">View Menu</a>
        <a href="#order" class="btn">Place Order</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Bakery</span>
        <h2 class="section-title">Fresh Daily</h2>
        <p class="section-description">Sourdough, pastries, and cakes baked fresh every morning.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Bread</span>
          <h3 class="card-title">Sourdough Loaf</h3>
          <p class="card-text">48-hour fermentation, organic wheat flour, sea salt.</p>
        </div>
        <div class="card">
          <span class="card-badge">Pastry</span>
          <h3 class="card-title">Croissant</h3>
          <p class="card-text">Butter-laminated, crisp exterior, airy interior.</p>
        </div>
        <div class="card">
          <span class="card-badge">Cake</span>
          <h3 class="card-title">Seasonal Cake</h3>
          <p class="card-text">Seasonal fruit cake, changes weekly.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Bakery · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>