---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Developer Platform" description="API-first, dark-native. For cloud provider, API company." template="template-developer-platform" lang="id">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Platform Pengembang</span>
      <h1>Mafyn <span class="accent">Developer Platform</span></h1>
      <p class="hero_description">API-first, dark-native. Untuk penyedia cloud, perusahaan API, dan infrastruktur.</p>
      <div class="hero-actions">
        <a href="#dokumen" class="btn btn-accent">Baca Dokumentasi</a>
        <a href="#papan-kontrol" class="btn">Buka Dashboard</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Produk</span>
        <h2 class="section-title">Produk Pengembang</h2>
        <p class="section-description">Semua yang Anda butuhkan untuk mengirim aplikasi produksi.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">API</span>
          <h3 class="card-title">REST API</h3>
          <p class="card-text">Desain API-first dengan dokumentasi lengkap dan SDK.</p>
        </div>
        <div class="card">
          <span class="card-badge">Komputasi</span>
          <h3 class="card-title">Serverless</h3>
          <p class="card-text">Fungsi serverless dengan penskalaan otomatis dan inisialisasi dingin optimal.</p>
        </div>
        <div class="card">
          <span class="card-badge">Penyimpanan</span>
          <h3 class="card-title">Penyimpanan Objek</h3>
          <p class="card-text">Penyimpanan objek yang tahan lama dengan manajemen siklus hidup dan pengelolaan versi.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Mulai Membangun Hari Ini</h2>
    <div class="cta-actions">
      <a href="#dokumen" class="btn btn-accent">Baca Dokumentasi</a>
      <a href="#harga" class="btn">Lihat Harga</a>
    </div>
  </section>

  <footer>
    <p>Mafyn Developer Platform · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
