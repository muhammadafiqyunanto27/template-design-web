---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Innovation Lab" description="Experimental, motion-heavy. For R&D labs." template="template-innovation-lab" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">R&D Lab</span>
      <h1>Mafyn <span class="accent">Innovation Lab</span></h1>
      <p class="hero-description">Experimental, motion-heavy. For R&amp;D labs and quantum computing startups.</p>
      <div class="hero-actions">
        <a href="#research" class="btn btn-accent">View Research</a>
        <a href="#labs" class="btn">Visit Labs</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Capabilities</span>
        <h2 class="section-title">Research Areas</h2>
        <p class="section-description">Cutting-edge research in quantum computing, AI, and materials science.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Quantum</span>
          <h3 class="card-title">Quantum Computing</h3>
          <p class="card-text">Quantum algorithms, error correction, and quantum software development.</p>
        </div>
        <div class="card">
          <span class="card-badge">AI</span>
          <h3 class="card-title">AI Research</h3>
          <p class="card-text">Large language models, reinforcement learning, and neural architecture search.</p>
        </div>
        <div class="card">
          <span class="card-badge">Materials</span>
          <h3 class="card-title">Materials Science</h3>
          <p class="card-text">Novel materials for quantum computing and energy storage.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Join Our Research</h2>
    <div class="cta-actions">
      <a href="#apply" class="btn btn-accent">Apply for Fellowship</a>
      <a href="#papers" class="btn">Read Papers</a>
    </div>
  </section>

  <footer>
    <p>Mafyn Innovation Lab · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
