---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Institutional" description="Structured, compliant. For banks, insurance, universities." template="template-corporate-institutional" lang="id">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Layanan Institusional</span>
      <h1>Mafyn <span class="accent">Institutional</span></h1>
      <p class="hero-description">Structured, compliant. Untuk bank, asuransi, universitas.</p>
      <div class="hero-actions">
        <a href="#layanan" class="btn btn-accent">Layanan</a>
        <a href="#kontak" class="btn">Kontak</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Layanan</span>
        <h2 class="section-title">Layanan Institusional</h2>
        <p class="section-description">Layanan kompatibel untuk bank, asuransi, dan universitas.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Kepatuhan</span>
          <h3 class="card-title">Kepatuhan Regulasi</h3>
          <p class="card-text">Kepatuhan penuh dengan regulasi keuangan dan standar industri.</p>
        </div>
        <div class="card">
          <span class="card-badge">Keamanan</span>
          <h3 class="card-title">Keamanan Enterprise</h3>
          <p class="card-text">Enkripsi end-to-end, sertifikasi SOC 2 dan SOC 3.</p>
        </div>
        <div class="card">
          <span class="card-badge">Audit</span>
          <h3 class="card-title">Audit Trail</h3>
          <p class="card-text">Lintasan audit lengkap untuk semua transaksi dan akses data.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Hubungi Tim Kami</h2>
    <div class="cta-actions">
      <a href="#kontak" class="btn btn-accent">Hubungi Sales</a>
      <a href="#layanan" class="btn">Lihat Layanan</a>
    </div>
  </section>

  <footer>
    <p>Mafyn Institutional · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
