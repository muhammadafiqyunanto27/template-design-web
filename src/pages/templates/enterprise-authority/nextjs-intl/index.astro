---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Enterprise Authority" description="Restrained, authoritative, accessible. For Fortune 500, governments, big tech." template="template-enterprise-authority" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Enterprise Authority</span>
      <h1>Enterprise Authority</h1>
      <p class="hero-description">Restrained, authoritative, accessible. For Fortune 500, governments, big tech.</p>
      <div class="hero-actions">
        <a href="/nextjs-intl/" class="btn">← Back to Templates</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Enterprise Authority</span>
        <h2 class="section-title">Built for Enterprise Challenges</h2>
        <p class="section-description">Purpose-built solutions for the most demanding regulatory, scale, and security requirements.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Security</span>
          <h3 class="card-title">Enterprise Security</h3>
          <p class="card-text">End-to-end encryption, zero-trust architecture, and compliance certifications for every industry.</p>
        </div>
        <div class="card">
          <span class="card-badge">Scale</span>
          <h3 class="card-title">Infinite Scale</h3>
          <p class="card-text">Handle millions of requests per second with automatic horizontal scaling. Pay only for what you use.</p>
        </div>
        <div class="card">
          <span class="card-badge">Infrastructure</span>
          <h3 class="card-title">Global Infrastructure</h3>
          <p class="card-text">Deploy across 35+ regions with sub-10ms latency. Built-in redundancy and automatic failover.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Compliance</span>
        <h2 class="section-title">Certifications & Standards</h2>
        <p class="section-description">Comprehensive compliance coverage for regulated industries worldwide.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">SOC 2</span>
          <h3 class="card-title">Type II Certified</h3>
          <p class="card-text">Security, availability, confidentiality.</p>
        </div>
        <div class="card">
          <span class="card-badge">ISO 27001</span>
          <h3 class="card-title">Information Security</h3>
          <p class="card-text">Information security management standard.</p>
        </div>
        <div class="card">
          <span class="card-badge">GDPR</span>
          <h3 class="card-title">Compliant</h3>
          <p class="card-text">EU data protection regulation.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Enterprise Authority · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
