---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Florist" description="Boutique flower shop with same-day delivery across Jakarta." template="mafyn-florist" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Florist</span>
      <h1>Mafyn <span class="accent">Florist</span></h1>
      <p class="hero-description">Seasonal floral arrangements, wedding flowers, and same-day delivery across Jakarta.</p>
      <div class="hero-actions">
        <a href="#shop" class="btn btn-accent">Order Flowers</a>
        <a href="#wedding" class="btn">Weddings</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Arrangements</span>
        <h2 class="section-title">Seasonal Bouquets</h2>
        <p class="section-description">Fresh, locally-sourced flowers arranged daily.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Bouquet</span>
          <h3 class="card-title">Spring Garden</h3>
          <p class="card-text">Peonies, ranunculus, and eucalyptus in soft pastels.</p>
        </div>
        <div class="card">
          <span class="card-badge">Bouquet</span>
          <h3 class="card-title">Tropical Bloom</h3>
          <p class="card-text">Heliconia, ginger, and monstera leaves.</p>
        </div>
        <div class="card">
          <span class="card-badge">Bouquet</span>
          <h3 class="card-title">Monochrome White</h3>
          <p class="card-text">White roses, lisianthus, and baby's breath.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Florist · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>