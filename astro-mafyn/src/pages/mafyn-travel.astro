---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Travel" description="Boutique travel agency curating journeys across Indonesia." template="mafyn-travel" lang="en">
  <section class="hero section-lg" style="background-image: url('/images/travel-hero.jpg'); background-size: cover; background-position: center; position: relative;">
    <div style="position: absolute; inset: 0; background: rgba(0,0,0,0.5); z-index: 1;"></div>
    <div style="position: relative; z-index: 2;">
      <span class="hero-eyebrow">Travel Agency</span>
      <h1>Mafyn <span class="accent">Travel</span></h1>
      <p class="hero-description">Curated journeys across Indonesia. From Bali beaches to Sumatran jungles, we design unforgettable experiences.</p>
      <div class="hero-actions">
        <a href="#destinations" class="btn btn-accent">Explore Destinations</a>
        <a href="#contact" class="btn">Plan Your Trip</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Destinations</span>
        <h2 class="section-title">Discover Indonesia</h2>
        <p class="section-description">From Aceh to Papua, we craft journeys that go beyond the ordinary.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Nature</span>
          <h3 class="card-title">Raja Ampat</h3>
          <p class="card-text">World-class diving, coral reefs, and remote island beauty.</p>
        </div>
        <div class="card">
          <span class="card-badge">Culture</span>
          <h3 class="card-title">Yogyakarta</h3>
          <p class="card-text">Borobudur temple, Javanese arts, and royal heritage.</p>
        </div>
        <div class="card">
          <span class="card-badge">Adventure</span>
          <h3 class="card-title">Mount Bromo</h3>
          <p class="card-text">Sunrise treks across volcanic landscapes in East Java.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Travel · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>