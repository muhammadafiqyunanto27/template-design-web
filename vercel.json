{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "echo 'Static HTML - no build required'",
  "devCommand": "echo 'Static site'",
  "installCommand": "echo 'No dependencies'",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/nextjs-intl", "destination": "/nextjs-intl/index.html" },
    { "source": "/nextjs-intl/:path*", "destination": "/nextjs-intl/:path*" },
    { "source": "/nextjs-id", "destination": "/nextjs-id/index.html" },
    { "source": "/nextjs-id/:path*", "destination": "/nextjs-id/:path*" },
    { "source": "/astro-intl", "destination": "/astro-intl/index.html" },
    { "source": "/astro-intl/:path*", "destination": "/astro-intl/:path*" },
    { "source": "/astro-id", "destination": "/astro-id/index.html" },
    { "source": "/astro-id/:path*", "destination": "/astro-id/:path*" }
  ]
}