---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Fashion" description="Contemporary clothing for the modern wardrobe." template="mafyn-fashion" lang="en">
  <section class="hero section-lg" style="background-image: url('/images/fashion-hero.jpg'); background-size: cover; background-position: center; position: relative;">
    <div style="position: absolute; inset: 0; background: rgba(250,249,246,0.85); z-index: 1;"></div>
    <div style="position: relative; z-index: 2;">
      <span class="hero-eyebrow">Spring Summer 2025</span>
      <h1>Mafyn <span class="accent">Fashion</span></h1>
      <p class="hero-description">Contemporary clothing for the modern wardrobe. Minimal silhouettes, natural fabrics, timeless design.</p>
      <div class="hero-actions">
        <a href="#shop" class="btn btn-accent">Shop Collection</a>
        <a href="#lookbook" class="btn">View Lookbook</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">New Arrivals</span>
        <h2 class="section-title">This Season</h2>
        <p class="section-description">Linen shirts, cotton trousers, and knitwear crafted for everyday wear.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Men</span>
          <h3 class="card-title">Oversized Linen Shirt</h3>
          <p class="card-text">100% European linen. Relaxed fit, corozo buttons, chest pocket.</p>
        </div>
        <div class="card">
          <span class="card-badge">Women</span>
          <h3 class="card-title">Wide-Leg Trousers</h3>
          <p class="card-text">Heavyweight cotton twill. High waist, pleated front, side slant pockets.</p>
        </div>
        <div class="card">
          <span class="card-badge">Unisex</span>
          <h3 class="card-title">Merino Crewneck</h3>
          <p class="card-text">100% merino wool. Ribbed cuffs and hem, straight fit, available in six colors.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Fashion · Jakarta, Indonesia · <a href="#contact">Contact</a></p>
  </footer>
</BaseLayout>