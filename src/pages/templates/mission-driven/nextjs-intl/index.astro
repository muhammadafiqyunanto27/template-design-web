---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Mission Driven" description="Story-led, evidence-based. For non-profit, climate tech." template="template-mission-driven" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Mission Driven</span>
      <h1>Mafyn <span class="accent">Mission Driven</span></h1>
      <p class="hero-description">Story-led, evidence-based. For non-profit, climate tech, social enterprise.</p>
      <div class="hero-actions">
        <a href="#mission" class="btn btn-accent">Our Mission</a>
        <a href="#impact" class="btn">View Impact</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Programs</span>
        <h2 class="section-title">Our Programs</h2>
        <p class="section-description">Community-driven programs for climate action and social impact.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Climate</span>
          <h3 class="card-title">Climate Action</h3>
          <p class="card-text">Carbon offset programs and reforestation initiatives.</p>
        </div>
        <div class="card">
          <span class="card-badge">Education</span>
          <h3 class="card-title">Education Access</h3>
          <p class="card-text">Scholarships and educational resources for underserved communities.</p>
        </div>
        <div class="card">
          <span class="card-badge">Health</span>
          <h3 class="card-title">Health Access</h3>
          <p class="card-text">Mobile clinics and telemedicine for remote communities.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Join Our Mission</h2>
    <div class="cta-actions">
      <a href="#donate" class="btn btn-accent">Donate Now</a>
      <a href="#volunteer" class="btn">Volunteer</a>
    </div>
  </section>

  <footer>
    <p>Mafyn Mission Driven · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
