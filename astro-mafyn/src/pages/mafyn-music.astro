---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Music" description="Independent record label and artist management." template="mafyn-music" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Record Label</span>
      <h1>Mafyn <span class="accent">Music</span></h1>
      <p class="hero-description">Independent record label and artist management. Electronic, jazz, and experimental music from Indonesia.</p>
      <div class="hero-actions">
        <a href="#artists" class="btn btn-accent">Artists</a>
        <a href="#music" class="btn">Listen</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Artists</span>
        <h2 class="section-title">Roster</h2>
        <p class="section-description">Independent musicians pushing boundaries in Indonesian music.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Electronic</span>
          <h3 class="card-title">Synth Waves</h3>
          <p class="card-text">Analog synth compositions from Bandung.</p>
        </div>
        <div class="card">
          <span class="card-badge">Jazz</span>
          <h3 class="card-title">Midnight Trio</h3>
          <p class="card-text">Contemporary jazz trio from Jakarta.</p>
        </div>
        <div class="card">
          <span class="card-badge">Experimental</span>
          <h3 class="card-title">Field Notes</h3>
          <p class="card-text">Field recordings and ambient textures.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Music · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>