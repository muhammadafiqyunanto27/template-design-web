---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Auto Care" description="Car detailing and ceramic coating studio." template="mafyn-auto-care" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Auto Detailing</span>
      <h1>Mafyn <span class="accent">Auto Care</span></h1>
      <p class="hero-description">Ceramic coating, paint protection film, and professional auto detailing in Jakarta.</p>
      <div class="hero-actions">
        <a href="#services" class="btn btn-accent">Services</a>
        <a href="#book" class="btn">Book Detailing</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Services</span>
        <h2 class="section-title">Paint Protection</h2>
        <p class="section-description">Ceramic coating, PPF, and professional detailing.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Coating</span>
          <h3 class="card-title">Ceramic Coating</h3>
          <p class="card-text">9H ceramic paint protection with 5-year warranty.</p>
        </div>
        <div class="card">
          <span class="card-badge">PPF</span>
          <h3 class="card-title">Paint Protection Film</h3>
          <p class="card-text">Clear bra film for high-impact areas.</p>
        </div>
        <div class="card">
          <span class="card-badge">Detail</span>
          <h3 class="card-title">Full Detail</h3>
          <p class="card-text">Interior and exterior deep cleaning and protection.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Auto Care · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>