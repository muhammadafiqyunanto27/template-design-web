---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Kitchen" description="Modern Indonesian restaurant serving heritage recipes." template="mafyn-kitchen" lang="en">
  <section class="hero section-lg" style="background-image: url('/images/kitchen-hero.jpg'); background-size: cover; background-position: center; position: relative;">
    <div style="position: absolute; inset: 0; background: linear-gradient(to bottom, rgba(0,0,0,0.3), rgba(0,0,0,0.7)); z-index: 1;"></div>
    <div style="position: relative; z-index: 2;">
      <span class="hero-eyebrow">Heritage Kitchen</span>
      <h1>Mafyn <span class="accent">Kitchen</span></h1>
      <p class="hero-description">Heritage Indonesian recipes cooked over wood fire. Family recipes from three generations, served in Jakarta.</p>
      <div class="hero-actions">
        <a href="#menu" class="btn btn-accent">View Menu</a>
        <a href="#reserve" class="btn">Reserve Table</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Signature Dishes</span>
        <h2 class="section-title">Flavors of the Archipelago</h2>
        <p class="section-description">From Sumatra to Papua, our menu celebrates Indonesia's diverse culinary heritage.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Main</span>
          <h3 class="card-title">Nasi Goreng Mafyn</h3>
          <p class="card-text">Wok-fried rice with shrimp, chicken, acar, and sambal matah. Served with prawn crackers.</p>
        </div>
        <div class="card">
          <span class="card-badge">Main</span>
          <h3 class="card-title">Sate Babi Kecap</h3>
          <p class="card-text">Grilled pork satay with sweet soy glaze, pickled cucumber, and steamed rice.</p>
        </div>
        <div class="card">
          <span class="card-badge">Dessert</span>
          <h3 class="card-title">Es Teler</h3>
          <p class="card-text">Avocado, jackfruit, coconut, and condensed milk over shaved ice.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Reserve Your Table</h2>
    <div class="cta-actions">
      <a href="#reserve" class="btn btn-accent">Book Now</a>
      <a href="#menu" class="btn">Full Menu</a>
    </div>
  </section>

  <footer>
    <p>Mafyn Kitchen · South Jakarta · Open 11:00 - 22:00</p>
  </footer>
</BaseLayout>