---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Institutional" description="Structured, compliant. For banks, insurance, universities." template="template-corporate-institutional" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Institutional Services</span>
      <h1>Mafyn <span class="accent">Institutional</span></h1>
      <p class="hero-description">Structured, compliant. For banks, insurance, universities.</p>
      <div class="hero-actions">
        <a href="#services" class="btn btn-accent">Services</a>
        <a href="#contact" class="btn">Contact</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Services</span>
        <h2 class="section-title">Institutional Services</h2>
        <p class="section-description">Compliant solutions for banks, insurance, and universities.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Compliance</span>
          <h3 class="card-title">Regulatory Compliance</h3>
          <p class="card-text">Full compliance with financial regulations and industry standards.</p>
        </div>
        <div class="card">
          <span class="card-badge">Security</span>
          <h3 class="card-title">Enterprise Security</h3>
          <p class="card-text">End-to-end encryption, SOC 2 compliant, SOC 3 certified.</p>
        </div>
        <div class="card">
          <span class="card-badge">Audit</span>
          <h3 class="card-title">Audit Trail</h3>
          <p class="card-text">Complete audit trails for all transactions and data access.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Contact Our Team</h2>
    <div class="cta-actions">
      <a href="#contact" class="btn btn-accent">Contact Sales</a>
      <a href="#services" class="btn">View Services</a>
    </div>
  </section>

  <footer>
    <p>Mafyn Institutional · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
