---
interface Props {
  title: string;
  description?: string;
  children: any;
  template?: string;
  lang?: 'en' | 'id';
}

const { title, description, children, template = 'default', lang = 'en' } = Astro.props;

const navLinks = {
  en: [
    { label: 'Home', href: '/' },
    { label: 'About', href: '/about' },
    { label: 'Work', href: '/work' },
    { label: 'Contact', href: '/contact' },
  ],
  id: [
    { label: 'Beranda', href: '/' },
    { label: 'Tentang', href: '/about' },
    { label: 'Karya', href: '/work' },
    { label: 'Kontak', href: '/contact' },
  ],
};

const c = lang === 'id' ? {
  toggleDark: 'Mode gelap',
  toggleLang: 'Bahasa Inggris',
  menu: 'Menu',
} : {
  toggleDark: 'Dark mode',
  toggleLang: 'Bahasa Indonesia',
  menu: 'Menu',
};

const links = lang === 'id' ? navLinks.id : navLinks.en;
---

<!DOCTYPE html>
<html lang={lang} class={template}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Mafyn</title>
  <meta name="description" content={description || `Mafyn ${title}`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;800&family=Inter:wght@400;600;800&family=JetBrains+Mono:wght@400;600&display=swap" />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body class={template}>
  <header>
    <div class="header-inner">
      <a href="/" class="navbar-brand">Mafyn<span>Design</span></a>
      <nav class="navbar-nav">
        {links.map((l) => (
          <a href={l.href} class="navbar-link">{l.label}</a>
        ))}
      </nav>
      <div class="navbar-actions">
        <button id="langToggle" class="btn btn-sm" aria-label={c.toggleLang} title={c.toggleLang}>
          {lang === 'en' ? 'ID' : 'EN'}
        </button>
        <button id="themeToggle" class="btn btn-sm" aria-label={c.toggleDark} title={c.toggleDark}>
          ☀️
        </button>
        <button class="menu-toggle" aria-label={c.menu}>
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
  </header>

  <main>{children}</main>

  <footer>
    <p>Mafyn Design System · <a href="https://github.com/muhammadafiqyunanto27/template-design-web" target="_blank" rel="noopener noreferrer">GitHub</a></p>
  </footer>

  <script is:inline>
    (function() {
      const toggle = document.getElementById('themeToggle');
      if (!toggle) return;
      const html = document.documentElement;
      const saved = localStorage.getItem('mafyn-theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

      if (saved === 'dark' || (!saved && prefersDark)) {
        html.setAttribute('data-theme', 'dark');
        toggle.textContent = '☀️';
      } else {
        html.removeAttribute('data-theme');
        toggle.textContent = '🌙';
      }

      toggle.addEventListener('click', () => {
        if (html.getAttribute('data-theme') === 'dark') {
          html.removeAttribute('data-theme');
          localStorage.setItem('mafyn-theme', 'light');
          toggle.textContent = '🌙';
        } else {
          html.setAttribute('data-theme', 'dark');
          localStorage.setItem('mafyn-theme', 'dark');
          toggle.textContent = '☀️';
        }
      });
    })();

    // Language toggle
    const langToggle = document.getElementById('langToggle');
    if (langToggle) {
      langToggle.addEventListener('click', () => {
        const currentPath = window.location.pathname;
        const isIntl = currentPath.includes('/intl/');
        const newPath = isIntl ? currentPath.replace('/intl/', '/id/') : currentPath.replace('/id/', '/intl/');
        window.location.href = newPath;
      });
    }

    // Mobile menu toggle
    const menuToggle = document.querySelector('.menu-toggle');
    const navbarNav = document.querySelector('.navbar-nav');
    if (menuToggle && navbarNav) {
      menuToggle.addEventListener('click', () => {
        const isOpen = navbarNav.classList.toggle('open');
        menuToggle.setAttribute('aria-expanded', isOpen);
      });
    }
  </script>
</body>
</html>