---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Law" description="Corporate law firm serving Indonesian and international clients." template="mafyn-law" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Legal Counsel</span>
      <h1>Mafyn <span class="accent">Law</span></h1>
      <p class="hero-description">Corporate law firm serving Indonesian and international clients. Mergers, acquisitions, employment, and dispute resolution.</p>
      <div class="hero-actions">
        <a href="#services" class="btn btn-accent">Practice Areas</a>
        <a href="#contact" class="btn">Schedule Consultation</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Practice Areas</span>
        <h2 class="section-title">Expertise</h2>
        <p class="section-description">Legal services for domestic and cross-border transactions.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Corporate</span>
          <h3 class="card-title">Mergers & Acquisitions</h3>
          <p class="card-text">Due diligence, transaction structuring, and closing for domestic and cross-border deals.</p>
        </div>
        <div class="card">
          <span class="card-badge">Employment</span>
          <h3 class="card-title">Labor Law</h3>
          <p class="card-text">Employment contracts, terminations, and industrial relations counseling.</p>
        </div>
        <div class="card">
          <span class="card-badge">Dispute</span>
          <h3 class="card-title">Litigation</h3>
          <p class="card-text">Civil litigation, arbitration, and alternative dispute resolution.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Law · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>