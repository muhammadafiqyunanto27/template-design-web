---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Med" description="Modern healthcare clinic providing comprehensive medical services." template="mafyn-med" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Healthcare Clinic</span>
      <h1>Mafyn <span class="accent">Med</span></h1>
      <p class="hero-description">Comprehensive healthcare services for individuals and families. Preventive care, diagnostics, and specialist consultations.</p>
      <div class="hero-actions">
        <a href="#services" class="btn btn-accent">Book Appointment</a>
        <a href="#doctors" class="btn">Meet Our Doctors</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Services</span>
        <h2 class="section-title">Comprehensive Care</h2>
        <p class="section-description">Preventive, diagnostic, and treatment services under one roof.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">General</span>
          <h3 class="card-title">General Practice</h3>
          <p class="card-text">Routine checkups, vaccinations, and chronic disease management.</p>
        </div>
        <div class="card">
          <span class="card-badge">Specialist</span>
          <h3 class="card-title">Specialist Consultation</h3>
          <p class="card-text">Cardiology, dermatology, pediatrics, and orthopedics available.</p>
        </div>
        <div class="card">
          <span class="card-badge">Diagnostic</span>
          <h3 class="card-title">Imaging & Lab</h3>
          <p class="card-text">X-ray, ultrasound, blood tests, and pathology on-site.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Med · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>