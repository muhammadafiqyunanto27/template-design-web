---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Mission Driven" description="Story-led, evidence-based. For non-profit, climate tech." template="template-mission-driven" lang="id">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Gerakan Sosial</span>
      <h1>Mafyn <span class="accent">Mission Driven</span></h1>
      <p class="hero_description">Cerita dipandu, berbukti. Untuk non-profit, iklim, perusahaan sosial.</p>
      <div class="hero-actions">
        <a href="#misi" class="btn btn-accent">Lihat Misi</a>
        <a href="#dampak" class="btn">Lihat Dampak</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Program</span>
        <h2 class="section-title">Program Kami</h2>
        <p class="section-description">Program komunitas untuk aksi iklim dan dampak sosial.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Iklim</span>
          <h3 class="card-title">Aksi Iklim</h3>
          <p class="card-text">Program pengurangan emisi karbon dan penanaman pohon.</p>
        </div>
        <div class="card">
          <span class="card-badge">Pendidikan</span>
          <h3 class="card-title">Akses Pendidikan</h3>
          <p class="card-text">Beasiswa dan sumber daya pendidikan untuk komunitas terpencil.</p>
        </div>
        <div class="card">
          <span class="card-badge">Kesehatan</span>
          <h3 class="card-title">Akses Kesehatan</h3>
          <p class="card-text">Klinik bergerak dan telemedis untuk komunitas terpencil.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Bergabung dalam Gerakan Kami</h2>
    <div class="cta-actions">
      <a href="#donasi" class="btn btn-accent">Donasikan Sekarang</a>
      <a href="#relawan" class="btn">Jadi Relawan</a>
    </div>
  </section>

  <footer>
    <p>Mafyn Mission Driven · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
