---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Tech" description="API-first infrastructure platform for developers." template="mafyn-tech" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Infrastructure Platform</span>
      <h1>Mafyn <span class="accent">Tech</span></h1>
      <p class="hero-description">Deploy APIs, databases, and frontend apps in seconds. Global edge network, automatic SSL, and zero-downtime deployments.</p>
      <div class="hero-actions">
        <a href="#docs" class="btn btn-accent">Start Building</a>
        <a href="#pricing" class="btn">View Pricing</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Features</span>
        <h2 class="section-title">Developer First</h2>
        <p class="section-description">Everything you need to ship production-grade applications.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Edge Network</span>
          <h3 class="card-title">Global Edge</h3>
          <p class="card-text">Deploy across 250+ locations. Sub-10ms latency worldwide.</p>
        </div>
        <div class="card">
          <span class="card-badge">Database</span>
          <h3 class="card-title">Managed Postgres</h3>
          <p class="card-text">Fully managed PostgreSQL with automatic backups.</p>
        </div>
        <div class="card">
          <span class="card-badge">CI/CD</span>
          <h3 class="card-title">Git Deploy</h3>
          <p class="card-text">Push to Git, deploy automatically. Preview environments for every PR.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Start Building</h2>
    <div class="cta-actions">
      <a href="#docs" class="btn btn-accent">Get Started</a>
      <a href="#pricing" class="btn">View Pricing</a>
    </div>
  </section>

  <footer>
    <p>Mafyn Tech · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>