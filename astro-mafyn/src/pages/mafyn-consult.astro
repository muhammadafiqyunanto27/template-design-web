---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Consult" description="Management consulting for growth-stage companies." template="mafyn-consult" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Management Consulting</span>
      <h1>Mafyn <span class="accent">Consult</span></h1>
      <p class="hero-description">Strategy, operations, and growth advisory for growth-stage companies in Indonesia.</p>
      <div class="hero-actions">
        <a href="#services" class="btn btn-accent">Services</a>
        <a href="#contact" class="btn">Contact Us</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Services</span>
        <h2 class="section-title">Strategic Advisory</h2>
        <p class="section-description">Growth strategy, operations, and organizational design.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Strategy</span>
          <h3 class="card-title">Growth Strategy</h3>
          <p class="card-text">Market entry, product strategy, and competitive positioning.</p>
        </div>
        <div class="card">
          <span class="card-badge">Operations</span>
          <h3 class="card-title">Operations Design</h3>
          <p class="card-text">Process optimization and organizational design.</p>
        </div>
        <div class="card">
          <span class="card-badge">Digital</span>
          <h3 class="card-title">Digital Transformation</h3>
          <p class="card-text">Technology adoption and digital workflow implementation.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Consult · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>