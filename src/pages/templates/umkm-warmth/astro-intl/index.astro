---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="UMKM Warmth" description="Human, authentic, warm. For local coffee, batik, bengkel, restoran keluarga." template="template-umkm-warmth" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Local Coffee Roastery · Jakarta</span>
      <h1>Mafyn <span class="accent">Warmth</span></h1>
      <p class="hero-description">Authentic Indonesian coffee roastery. Hand-roasted daily. Specialty beans from Aceh, Gayo, Toraja, and Flores.</p>
      <div class="hero-actions">
        <a href="#shop" class="btn btn-accent">Shop Coffee</a>
        <a href="#story" class="btn">Our Story</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Our Roast</span>
        <h2 class="section-title">From Farm to Cup</h2>
        <p class="section-description">We work directly with Indonesian farmers across Aceh, Gayo, Toraja, and Flores.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Origin</span>
          <h3 class="card-title">Aceh Gayo</h3>
          <p class="card-text">Volcanic soil, high altitude, natural process. Notes of dark chocolate and tobacco.</p>
        </div>
        <div class="card">
          <span class="card-badge">Origin</span>
          <h3 class="card-title">Toraja</h3>
          <p class="card-text">Wet-hulled process, earthy body, spice notes.</p>
        </div>
        <div class="card">
          <span class="card-badge">Origin</span>
          <h3 class="card-title">Flores</h3>
          <p class="card-text">Washed process, bright acidity, citrus and floral notes.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Order Fresh Coffee</h2>
    <div class="cta-actions">
      <a href="#shop" class="btn btn-accent">Order Now</a>
      <a href="#about" class="btn">Our Story</a>
    </div>
  </section>

  <footer>
    <p>Mafyn Coffee · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
