---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Design" description="Product design consultancy for startups and established companies." template="mafyn-design" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Product Design</span>
      <h1>Mafyn <span class="accent">Design</span></h1>
      <p class="hero-description">Product design consultancy for startups and established companies. UX, UI, and product strategy.</p>
      <div class="hero-actions">
        <a href="#services" class="btn btn-accent">Services</a>
        <a href="#work" class="btn">View Work</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Services</span>
        <h2 class="section-title">Product Design</h2>
        <p class="section-description">End-to-end product design from research to launch.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">UX Design</span>
          <h3 class="card-title">User Research</h3>
          <p class="card-text">User interviews, usability testing, and journey mapping.</p>
        </div>
        <div class="card">
          <span class="card-badge">UI Design</span>
          <h3 class="card-title">Interface Design</h3>
          <p class="card-text">Visual design, component libraries, and design systems.</p>
        </div>
        <div class="card">
          <span class="card-badge">Strategy</span>
          <h3 class="card-title">Product Strategy</h3>
          <p class="card-text">Product roadmaps, market analysis, and positioning.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Design · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>