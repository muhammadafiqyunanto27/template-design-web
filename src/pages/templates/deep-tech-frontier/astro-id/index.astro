---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Deep Tech Frontier" description="Dark, technical, data-dense. For aerospace, quantum, defense." template="template-deep-tech-frontier" lang="id">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Infrastruktur Platform</span>
      <h1>Mafyn <span class="accent">Tech</span></h1>
      <p class="hero-description">Deploy API, database, dan frontend app dalam detik. Jaringan edge global, otomatis SSL, dan deployment tanpa downtime.</p>
      <div class="hero-actions">
        <a href="#docs" class="btn btn-accent">Mulai Membangun</a>
        <a href="#pricing" class="btn">Lihat Harga</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Fitur</span>
        <h2 class="section-title">Pertama untuk Pengembang</h2>
        <p class="section-description">Semua yang Anda butuhkan untuk mengirim aplikasi produksi.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Edge Network</span>
          <h3 class="card-title">Jaringan Edge Global</h3>
          <p class="card-text">Deploy di 250+ lokasi. Latensi &lt;10ms di seluruh dunia.</p>
        </div>
        <div class="card">
          <span class="card-badge">Database</span>
          <h3 class="card-title">Postgres Terkelola</h3>
          <p class="card-text">PostgreSQL terkelola dengan pencadangan otomatis.</p>
        </div>
        <div class="card">
          <span class="card-badge">CI/CD</span>
          <h3 class="card-title">Git Deploy</h3>
          <p class="card-text">Push ke Git, deploy otomatis. Lingkungan pratinjau untuk setiap PR.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Mulai Membangun</h2>
    <div class="cta-actions">
      <a href="#docs" class="btn btn-accent">Mulai Sekarang</a>
      <a href="#pricing" class="btn">Lihat Harga</a>
    </div>
  </section>

  <footer>
    <p>Mafyn Tech · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
