---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn SaaS" description="Demo-driven, developer-friendly. For B2B SaaS, dev tools, AI startup." template="template-saas-product-led" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">SaaS Platform</span>
      <h1>Mafyn <span class="accent">SaaS</span></h1>
      <p class="hero-description">Demo-driven, developer-friendly. For B2B SaaS, dev tools, AI startup.</p>
      <div class="hero-actions">
        <a href="#features" class="btn btn-accent">Start Building</a>
        <a href="#pricing" class="btn">View Pricing</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Features</span>
        <h2 class="section-title">Built for Developers</h2>
        <p class="section-description">Everything you need to ship production-grade applications.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">API</span>
          <h3 class="card-title">API-First</h3>
          <p class="card-text">API-first design with comprehensive documentation and SDKs.</p>
        </div>
        <div class="card">
          <span class="card-badge">Scale</span>
          <h3 class="card-title">Auto-Scale</h3>
          <p class="card-text">Automatic scaling based on demand. No manual intervention needed.</p>
        </div>
        <div class="card">
          <span class="card-badge">Secure</span>
          <h3 class="card-title">Enterprise Security</h3>
          <p class="card-text">SOC 2 compliant, end-to-end encryption, and access controls.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Start Building Today</h2>
    <div class="cta-actions">
      <a href="#docs" class="btn btn-accent">Get Started Free</a>
      <a href="#pricing" class="btn">View Pricing</a>
    </div>
  </section>

  <footer>
    <p>Mafyn SaaS · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
