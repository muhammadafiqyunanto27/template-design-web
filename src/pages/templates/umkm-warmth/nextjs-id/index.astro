---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="UMKM Warmth" description="Human, authentic, warm. For local coffee, batik, bengkel, restoran keluarga." template="template-umkm-warmth" lang="id">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Pengrajin Kopi Lokal · Jakarta</span>
      <h1>Mafyn <span class="accent">Warmth</span></h1>
      <p class="hero-description">Kopi lokal autentik. Dibakar tangan setiap hari. Biji kopi spesial dari Aceh, Gayo, Toraja, dan Flores.</p>
      <div class="hero-actions">
        <a href="#shop" class="btn btn-accent">Beli Kopi</a>
        <a href="#about" class="btn">Cerita Kami</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Kopi Kami</span>
        <h2 class="section-title">Dari Petani ke Cangkir</h2>
        <p class="section-description">Kami bekerja langsung dengan petani kopi di Aceh, Gayo, Toraja, dan Flores. Setiap biji dicuri, dibakar, dan dikemas dengan perhatian.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Asal</span>
          <h3 class="card-title">Aceh Gayo</h3>
          <p class="card-text">Tanah vulkanik, ketinggian tinggi, proses alami. Cokelat hitam dan tembakau.</p>
        </div>
        <div class="card">
          <span class="card-badge">Asal</span>
          <h3 class="card-title">Toraja</h3>
          <p class="card-text">Proses basah-giling, badan lempah, rempah-rempah.</p>
        </div>
        <div class="card">
          <span class="card-badge">Asal</span>
          <h3 class="card-title">Flores</h3>
          <p class="card-text">Proses cuci, keasaman cerah, jeruk dan bunga.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Pesan Kopi Segar</h2>
    <div class="cta-actions">
      <a href="#shop" class="btn btn-accent">Pesan Sekarang</a>
      <a href="#about" class="btn">Cerita Kami</a>
    </div>
  </section>

  <footer>
    <p>Mafyn Coffee · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
