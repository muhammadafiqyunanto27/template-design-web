---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Innovation Lab" description="Experimental, motion-heavy. For R&D labs." template="template-innovation-lab" lang="id">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Lab Inovasi</span>
      <h1>Mafyn <span class="accent">Innovation Lab</span></h1>
      <p class="hero-description">Experimental, motion-heavy. Untuk laboratorium R&D dan startup komputasi kuantum.</p>
      <div class="hero-actions">
        <a href="#penelitian" class="btn btn-accent">Lihat Penelitian</a>
        <a href="#lab" class="btn">Kunjungi Lab</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Kapasitas</span>
        <h2 class="section-title">Bidang Riset</h2>
        <p class="section-description">Riset canggih dalam komputasi kuantum, AI, dan ilmu bahan.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Kuantum</span>
          <h3 class="card-title">Komputasi Kuantum</h3>
          <p class="card-text">Algoritma kuantum, koreksi kesalahan, dan perangkat lunak kuantum.</p>
        </div>
        <div class="card">
          <span class="card-badge">AI</span>
          <h3 class="card-title">Riset AI</h3>
          <p class="card-text">Model bahasa besar, pembelajaran penguatan, dan pencarian arsitektur neural.</p>
        </div>
        <div class="card">
          <span class="card-badge">Bahan</span>
          <h3 class="card-title">Ilmu Bahan</h3>
          <p class="card-text">Bahan baru untuk komputasi kuantum dan penyimpanan energi.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Gabung dalam Riset Kami</h2>
    <div class="cta-actions">
      <a href="#daftar" class="btn btn-accent">Daftar Magang Riset</a>
      <a href="#makalah" class="btn">Baca Makalah</a>
    </div>
  </section>

  <footer>
    <p>Mafyn Innovation Lab · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
