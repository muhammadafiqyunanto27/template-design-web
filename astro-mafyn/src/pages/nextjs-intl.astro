---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Next.js International" description="10 Next.js company profile templates." template="nextjs-intl" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Next.js International</span>
      <h1>Next.js <span class="accent">International</span></h1>
      <p class="hero-description">10 company profile templates built with Next.js App Router. English locale.</p>
      <div class="hero-actions">
        <a href="/" class="btn">← Back to Home</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-cols-2">
        <div class="card">
          <span class="card-badge">01</span>
          <h3 class="card-title">Enterprise Authority</h3>
          <p class="card-text">Restrained, authoritative, accessible.</p>
        </div>
        <div class="card">
          <a href="/templates/enterprise-authority/nextjs-intl/index.html" class="btn btn-accent" style="justify-content:flex-end;">Open →</a>
        </div>
        <div class="card">
          <span class="card-badge">02</span>
          <h3 class="card-title">Deep Tech Frontier</h3>
          <p class="card-text">Dark, technical, data-dense.</p>
        </div>
        <div class="card">
          <a href="/templates/deep-tech-frontier/nextjs-intl/index.html" class="btn btn-accent" style="justify-content:flex-end;">Open →</a>
        </div>
        <div class="card">
          <span class="card-badge">03</span>
          <h3 class="card-title">UMKM Warmth</h3>
          <p class="card-text">Human, authentic, warm.</p>
        </div>
        <div class="card">
          <a href="/templates/umkm-warmth/nextjs-intl/index.html" class="btn btn-accent" style="justify-content:flex-end;">Open →</a>
        </div>
        <div class="card">
          <span class="card-badge">04</span>
          <h3 class="card-title">Creative Studio</h3>
          <p class="card-text">Portfolio-first, visual density.</p>
        </div>
        <div class="card">
          <a href="/templates/creative-studio/nextjs-intl/index.html" class="btn btn-accent" style="justify-content:flex-end;">Open →</a>
        </div>
        <div class="card">
          <span class="card-badge">05</span>
          <h3 class="card-title">SaaS Product-Led</h3>
          <p class="card-text">Demo-driven, developer-friendly.</p>
        </div>
        <div class="card">
          <a href="/templates/saas-product-led/nextjs-intl/index.html" class="btn btn-accent" style="justify-content:flex-end;">Open →</a>
        </div>
        <div class="card">
          <span class="card-badge">06</span>
          <h3 class="card-title">Innovation Lab</h3>
          <p class="card-text">Experimental, motion-heavy.</p>
        </div>
        <div class="card">
          <a href="/templates/innovation-lab/nextjs-intl/index.html" class="btn btn-accent" style="justify-content:flex-end;">Open →</a>
        </div>
        <div class="card">
          <span class="card-badge">07</span>
          <h3 class="card-title">Corporate Institutional</h3>
          <p class="card-text">Structured, compliant.</p>
        </div>
        <div class="card">
          <a href="/templates/corporate-institutional/nextjs-intl/index.html" class="btn btn-accent" style="justify-content:flex-end;">Open →</a>
        </div>
        <div class="card">
          <span class="card-badge">08</span>
          <h3 class="card-title">Mission Driven</h3>
          <p class="card-text">Story-led, evidence-based.</p>
        </div>
        <div class="card">
          <a href="/templates/mission-driven/nextjs-intl/index.html" class="btn btn-accent" style="justify-content:flex-end;">Open →</a>
        </div>
        <div class="card">
          <span class="card-badge">09</span>
          <h3 class="card-title">Developer Platform</h3>
          <p class="card-text">API-first, dark-native.</p>
        </div>
        <div class="card">
          <a href="/templates/developer-platform/nextjs-intl/index.html" class="btn btn-accent" style="justify-content:flex-end;">Open →</a>
        </div>
        <div class="card">
          <span class="card-badge">10</span>
          <h3 class="card-title">Modular Agency</h3>
          <p class="card-text">Component showcase, themeable.</p>
        </div>
        <div class="card">
          <a href="/templates/modular-agency/nextjs-intl/index.html" class="btn btn-accent" style="justify-content:flex-end;">Open →</a>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Design System · <a href="/" style="color: var(--color-ink-3);">Back to Home</a></p>
  </footer>
</BaseLayout>