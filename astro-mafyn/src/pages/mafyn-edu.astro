---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Edu" description="Language school and professional training center." template="mafyn-edu" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Language School</span>
      <h1>Mafyn <span class="accent">Edu</span></h1>
      <p class="hero-description">Language courses and professional training for adults and corporate clients. English, Mandarin, Japanese, and Bahasa Indonesia.</p>
      <div class="hero-actions">
        <a href="#courses" class="btn btn-accent">View Courses</a>
        <a href="#enroll" class="btn">Enroll Now</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Programs</span>
        <h2 class="section-title">Learn & Grow</h2>
        <p class="section-description">Language proficiency and professional skills for career advancement.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Language</span>
          <h3 class="card-title">English Intensive</h3>
          <p class="card-text">Beginner to advanced. IELTS and TOEFL preparation available.</p>
        </div>
        <div class="card">
          <span class="card-badge">Language</span>
          <h3 class="card-title">Mandarin</h3>
          <p class="card-text">HSK preparation with native-speaking instructors.</p>
        </div>
        <div class="card">
          <span class="card-badge">Professional</span>
          <h3 class="card-title">Digital Marketing</h3>
          <p class="card-text">SEO, social media, and content strategy for modern businesses.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Edu · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>