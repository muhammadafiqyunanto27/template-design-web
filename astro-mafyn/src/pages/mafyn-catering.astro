---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Catering" description="Event catering for corporate events, weddings, and private parties." template="mafyn-catering" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Event Catering</span>
      <h1>Mafyn <span class="accent">Catering</span></h1>
      <p class="hero-description">Event catering for corporate functions, weddings, and private parties across Jakarta.</p>
      <div class="hero-actions">
        <a href="#menu" class="btn btn-accent">View Menu</a>
        <a href="#inquiry" class="btn">Request Quote</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Services</span>
        <h2 class="section-title">Event Catering</h2>
        <p class="section-description">Buffet, plated dinner, and cocktail reception catering.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Event</span>
          <h3 class="card-title">Corporate Events</h3>
          <p class="card-text">Product launches, annual dinners, and team lunches.</p>
        </div>
        <div class="card">
          <span class="card-badge">Wedding</span>
          <h3 class="card-title">Wedding Catering</h3>
          <p class="card-text">Reception menus, cocktail hours, and dessert stations.</p>
        </div>
        <div class="card">
          <span class="card-badge">Private</span>
          <h3 class="card-title">Private Parties</h3>
          <p class="card-text">Birthday parties, anniversaries, and intimate gatherings.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Catering · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>