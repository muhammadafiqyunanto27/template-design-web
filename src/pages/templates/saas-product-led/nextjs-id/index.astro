---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn SaaS" description="Demo-driven, developer-friendly. For B2B SaaS, dev tools, AI startup." template="template-saas-product-led" lang="id">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Platform SaaS</span>
      <h1>Mafyn <span class="accent">SaaS</span></h1>
      <p class="hero-description">Demo-driven, developer-friendly. Untuk B2B SaaS, dev tools, AI startup.</p>
      <div class="hero-actions">
        <a href="#fitur" class="btn btn-accent">Mulai Membangun</a>
        <a href="#harga" class="btn">Lihat Harga</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Fitur</span>
        <h2 class="section-title">Pertama untuk Pengembang</h2>
        <p class="section-description">Semua yang Anda butuhkan untuk mengirim aplikasi produksi.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">API</span>
          <h3 class="card-title">API-First</h3>
          <p class="card-text">Desain API-first dengan dokumentasi lengkap dan SDK.</p>
        </div>
        <div class="card">
          <span class="card-badge">Skala</span>
          <h3 class="card-title">Auto-Scale</h3>
          <p class="card-text">Penskalaan otomatis berdasarkan permintaan. Tanpa intervensi manual.</p>
        </div>
        <div class="card">
          <span class="card-badge">Keamanan</span>
          <h3 class="card-title">Keamanan Enterprise</h3>
          <p class="card-text">Sertifikasi SOC 2, enkripsi end-to-end, dan kontrol akses.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Mulai Membangun Hari Ini</h2>
    <div class="cta-actions">
      <a href="#docs" class="btn btn-accent">Mulai Sekarang</a>
      <a href="#pricing" class="btn">Lihat Harga</a>
    </div>
  </section>

  <footer>
    <p>Mafyn SaaS · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
