---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Creative" description="Portfolio-first, visual density. For design agencies, architects." template="template-creative-studio" lang="id">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Studio Kreatif</span>
      <h1>Mafyn <span class="accent">Creative</span></h1>
      <p class="hero-description">Identitas merek, pengalaman digital, dan komunikasi visual untuk perusahaan yang berpikiran maju.</p>
      <div class="hero-actions">
        <a href="#work" class="btn btn-accent">Lihat Karya</a>
        <a href="#contact" class="btn">Kontak</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Karya Terpilih</span>
        <h2 class="section-title">Karya Terkini</h2>
        <p class="section-description">Identitas merek, situs web, dan kampanye untuk klien di berbagai industri.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Identitas</span>
          <h3 class="card-title">Identitas Hotel</h3>
          <p class="card-text">Identitas visual lengkap untuk hotel boutique di Yogyakarta.</p>
        </div>
        <div class="card">
          <span class="card-badge">Digital</span>
          <h3 class="card-title">E-commerce Site</h3>
          <p class="card-text">Toko online responsif untuk brand fashion berkelanjutan.</p>
        </div>
        <div class="card">
          <span class="card-badge">Kampanye</span>
          <h3 class="card-title">Campaign Launch</h3>
          <p class="card-text">Kampanye peluncuran untuk startup fintech Seri A.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Creative · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
