---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Finance" description="Financial advisory and investment management for individuals and institutions." template="mafyn-finance" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Financial Advisory</span>
      <h1>Mafyn <span class="accent">Finance</span></h1>
      <p class="hero-description">Investment management, wealth planning, and corporate finance for discerning clients.</p>
      <div class="hero-actions">
        <a href="#services" class="btn btn-accent">Our Services</a>
        <a href="#contact" class="btn">Request Consultation</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Services</span>
        <h2 class="section-title">Wealth Management</h2>
        <p class="section-description">Disciplined investment strategies for long-term wealth preservation.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Investment</span>
          <h3 class="card-title">Portfolio Management</h3>
          <p class="card-text">Discretionary portfolio management tailored to your risk profile.</p>
        </div>
        <div class="card">
          <span class="card-badge">Planning</span>
          <h3 class="card-title">Financial Planning</h3>
          <p class="card-text">Retirement, estate, and tax planning for high-net-worth individuals.</p>
        </div>
        <div class="card">
          <span class="card-badge">Corporate</span>
          <h3 class="card-title">Corporate Finance</h3>
          <p class="card-text">Capital structure, fundraising, and M&A advisory for businesses.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Finance · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>