---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Design" description="Component showcase, themeable. For white-label, design systems." template="template-modular-agency" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Design Agency</span>
      <h1>Mafyn <span class="accent">Design</span></h1>
      <p class="hero-description">Component showcase, themeable. For white-label, design systems.</p>
      <div class="hero-actions">
        <a href="#services" class="btn btn-accent">Services</a>
        <a href="#work" class="btn">View Work</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Services</span>
        <h2 class="section-title">Design Services</h2>
        <p class="section-description">Component showcase, themeable design systems for modern agencies.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Design</span>
          <h3 class="card-title">UI/UX Design</h3>
          <p class="card-text">User interface design with component libraries and design systems.</p>
        </div>
        <div class="card">
          <span class="card-badge">Design</span>
          <h3 class="card-title">Design Systems</h3>
          <p class="card-text">Component libraries and design systems for consistent branding.</p>
        </div>
        <div class="card">
          <span class="card-badge">White-label</span>
          <h3 class="card-title">White-label Solutions</h3>
          <p class="card-text">White-label solutions for agencies and multi-brand companies.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Start Your Project</h2>
    <div class="cta-actions">
      <a href="#services" class="btn btn-accent">View Services</a>
      <a href="#work" class="btn">View Work</a>
    </div>
  </section>

  <footer>
    <p>Mafyn Design · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
