---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Archi" description="Architectural design studio specializing in sustainable residential and commercial projects." template="mafyn-archi" lang="en">
  <section class="hero section-lg" style="background-image: url('/images/archi-hero.jpg'); background-size: cover; background-position: center; position: relative;">
    <div style="position: absolute; inset: 0; background: rgba(0,0,0,0.6); z-index: 1;"></div>
    <div style="position: relative; z-index: 2;">
      <span class="hero-eyebrow">Architecture & Design</span>
      <h1>Mafyn <span class="accent">Archi</span></h1>
      <p class="hero-description">Sustainable residential and commercial architecture. Designing spaces that respond to climate, context, and community.</p>
      <div class="hero-actions">
        <a href="#projects" class="btn btn-accent">View Projects</a>
        <a href="#about" class="btn">About the Studio</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Selected Works</span>
        <h2 class="section-title">Built Environment</h2>
        <p class="section-description">From residential homes to public institutions, each project responds to its site and program.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Residential</span>
          <h3 class="card-title">House in Canggu</h3>
          <p class="card-text">Tropical modernism with cross-ventilation and rainwater harvesting.</p>
        </div>
        <div class="card">
          <span class="card-badge">Commercial</span>
          <h3 class="card-title">Office in Sudirman</h3>
          <p class="card-text">Adaptive reuse of a 1990s office building with solar facade.</p>
        </div>
        <div class="card">
          <span class="card-badge">Public</span>
          <h3 class="card-title">Community Center</h3>
          <p class="card-text">Community library and multipurpose hall in West Java.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Archi · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>