---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Design" description="Component showcase, themeable. For white-label, design systems." template="template-modular-agency" lang="id">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Studio Desain</span>
      <h1>Mafyn <span class="accent">Design</span></h1>
      <p class="hero_description">Pameran komponen, tema. Untuk platform white-label, sistem desain.</p>
      <div class="hero-actions">
        <a href="#layanan" class="btn btn-accent">Layanan</a>
        <a href="#karya" class="btn">Lihat Karya</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Layanan</span>
        <h2 class="section-title">Layanan Desain</h2>
        <p class="section-description">Pameran komponen, desain sistem tema untuk agensi modern.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Desain</span>
          <h3 class="card-title">Desain UI/UX</h3>
          <p class="card-text">Desain antarmuka pengguna dengan pustaka komponen dan sistem desain.</p>
        </div>
        <div class="card">
          <span class="card-badge">Desain</span>
          <h3 class="card-title">Sistem Desain</h3>
          <p class="card-text">Pustaka komponen dan token desain untuk identitas konsisten.</p>
        </div>
        <div class="card">
          <span class="card-badge">White-label</span>
          <h3 class="card-title">Solusi White-label</h3>
          <p class="card-text">Solusi white-label untuk agensi dan perusahaan multi-merek.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Mulai Proyek Anda</h2>
    <div class="cta-actions">
      <a href="#layanan" class="btn btn-accent">Lihat Layanan</a>
      <a href="#karya" class="btn">Lihat Karya</a>
    </div>
  </section>

  <footer>
    <p>Mafyn Design · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
