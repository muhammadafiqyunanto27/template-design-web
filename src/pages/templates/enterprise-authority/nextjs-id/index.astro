---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Enterprise Authority" description="Restrained, authoritative, accessible. For Fortune 500, governments, big tech." template="template-enterprise-authority" lang="id">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Enterprise Authority</span>
      <h1>Mafyn <span class="accent">Enterprise Authority</span></h1>
      <p class="hero-description">Restrained, authoritative, accessible. For Fortune 500, governments, big tech.</p>
      <div class="hero-actions">
        <a href="/nextjs-id/" class="btn">← Kembali ke Template</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Enterprise Authority</span>
        <h2 class="section-title">Dibangun untuk Tantangan Enterprise</h2>
        <p class="section-description">Solusi bersifat khusus untuk persyaratan regulasi, skala, dan keamanan paling menuntut.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Keamanan</span>
          <h3 class="card-title">Keamanan Enterprise</h3>
          <p class="card-text">Enkripsi end-to-end, arsitektur zero-trust, dan sertifikasi kepatuhan untuk setiap industri.</p>
        </div>
        <div class="card">
          <span class="card-badge">Skala</span>
          <h3 class="card-title">Skala Tak Terbatas</h3>
          <p class="card-text">Menangani jutaan permintaan per detik dengan penskalaan horizontal otomatis.</p>
        </div>
        <div class="card">
          <span class="card-badge">Infrastruktur</span>
          <h3 class="card-title">Infrastruktur Nasional</h3>
          <p class="card-text">Deploy di 4 region Indonesia dengan latensi &lt;10ms. Redundansi bawaan dan failover otomatis.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background: var(--color-surface);">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Kepatuhan</span>
        <h2 class="section-title">Sertifikasi & Standar Indonesia</h2>
        <p class="section-description">Cakupan kepatuhan komprehensif untuk industri terregulasi di Indonesia.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">BPOM</span>
          <h3 class="card-title">Terdaftar BPOM RI</h3>
          <p class="card-text">Penyelenggara Sistem Elektronik (PSE).</p>
        </div>
        <div class="card">
          <span class="card-badge">ISO 27001</span>
          <h3 class="card-title">Manajemen Keamanan</h3>
          <p class="card-text">Manajemen keamanan informasi.</p>
        </div>
        <div class="card">
          <span class="card-badge">OJK</span>
          <h3 class="card-title">Standar OJK</h3>
          <p class="card-text">Keamanan data jasa keuangan.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Enterprise Authority · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
