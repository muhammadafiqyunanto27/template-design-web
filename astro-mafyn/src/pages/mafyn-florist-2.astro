---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Florals" description="Wedding and event floristry studio." template="mafyn-florals" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Floral Studio</span>
      <h1>Mafyn <span class="accent">Florals</span></h1>
      <p class="hero-description">Wedding floristry, event styling, and everyday bouquets delivered across Jakarta.</p>
      <div class="hero-actions">
        <a href="#weddings" class="btn btn-accent">Weddings</a>
        <a href="#shop" class="btn">Shop Bouquets</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Services</span>
        <h2 class="section-title">Floral Design</h2>
        <p class="section-description">Bespoke floristry for weddings, events, and everyday moments.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Wedding</span>
          <h3 class="card-title">Wedding Design</h3>
          <p class="card-text">Ceremony arches, table arrangements, and bridal bouquets.</p>
        </div>
        <div class="card">
          <span class="card-badge">Event</span>
          <h3 class="card-title">Event Styling</h3>
          <p class="card-text">Corporate events, product launches, and private parties.</p>
        </div>
        <div class="card">
          <span class="card-badge">Subscription</span>
          <h3 class="card-title">Weekly Delivery</h3>
          <p class="card-text">Fresh flowers delivered to your home or office weekly.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Florals · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>