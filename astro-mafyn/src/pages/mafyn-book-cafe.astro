---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Book Cafe" description="Bookstore cafe with daily events and readings." template="mafyn-book-cafe" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Bookstore Cafe</span>
      <h1>Mafyn <span class="accent">Book Cafe</span></h1>
      <p class="hero-description">Books, coffee, and conversation. Daily readings, book clubs, and quiet reading nooks.</p>
      <div class="hero-actions">
        <a href="#books" class="btn btn-accent">Browse Books</a>
        <a href="#menu" class="btn">Cafe Menu</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Cafe Menu</span>
        <h2 class="section-title">Coffee & Books</h2>
        <p class="section-description">Single-origin coffee, pastries, and quiet reading spaces.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Coffee</span>
          <h3 class="card-title">Pour Over</h3>
          <p class="card-text">Single-origin Indonesian coffee, brewed to order.</p>
        </div>
        <div class="card">
          <span class="card-badge">Pastry</span>
          <h3 class="card-title">Almond Croissant</h3>
          <p class="card-text">Butter-laminated with almond filling.</p>
        </div>
        <div class="card">
          <span class="card-badge">Tea</span>
          <h3 class="card-title">Loose Leaf Tea</h3>
          <p class="card-text">Organic herbal and black teas from local farms.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Book Cafe · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>