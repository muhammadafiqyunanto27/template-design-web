---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Developer Platform" description="API-first, dark-native. For cloud provider, API company." template="template-developer-platform" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Developer Platform</span>
      <h1>Mafyn <span class="accent">Developer Platform</span></h1>
      <p class="hero-description">API-first, dark-native. For cloud providers, API companies, and infrastructure platforms.</p>
      <div class="hero-actions">
        <a href="#docs" class="btn btn-accent">Read Docs</a>
        <a href="#dashboard" class="btn">Open Dashboard</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Products</span>
        <h2 class="section-title">Developer Tools</h2>
        <p class="section-description">Everything you need to ship production-grade applications.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">API</span>
          <h3 class="card-title">REST API</h3>
          <p class="card-text">RESTful API with comprehensive documentation and SDKs.</p>
        </div>
        <div class="card">
          <span class="card-badge">Compute</span>
          <h3 class="card-title">Serverless</h3>
          <p class="card-text">Serverless functions with automatic scaling and cold start optimization.</p>
        </div>
        <div class="card">
          <span class="card-badge">Storage</span>
          <h3 class="card-title">Object Storage</h3>
          <p class="card-text">Durable object storage with lifecycle management and versioning.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="cta">
    <h2 class="cta-title">Start Building</h2>
    <div class="cta-actions">
      <a href="#docs" class="btn btn-accent">Get Started Free</a>
      <a href="#pricing" class="btn">View Pricing</a>
    </div>
  </section>

  <footer>
    <p>Mafyn Developer Platform · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>
