---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Mafyn Creative" description="Design agency specializing in brand identity and digital experiences." template="mafyn-creative" lang="en">
  <section class="hero section-lg">
    <div class="container">
      <span class="hero-eyebrow">Creative Agency</span>
      <h1>Mafyn <span class="accent">Creative</span></h1>
      <p class="hero-description">Brand identity, digital experiences, and visual communication for forward-thinking companies.</p>
      <div class="hero-actions">
        <a href="#work" class="btn btn-accent">View Work</a>
        <a href="#contact" class="btn">Start a Project</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-header">
        <span class="section-eyebrow">Selected Work</span>
        <h2 class="section-title">Recent Projects</h2>
        <p class="section-description">Identity design, websites, and campaigns for clients across industries.</p>
      </div>
      <div class="grid grid-cols-3">
        <div class="card">
          <span class="card-badge">Identity</span>
          <h3 class="card-title">Hotel Branding</h3>
          <p class="card-text">Full visual identity for boutique hotel in Yogyakarta.</p>
        </div>
        <div class="card">
          <span class="card-badge">Digital</span>
          <h3 class="card-title">E-commerce Site</h3>
          <p class="card-text">Responsive online store for sustainable fashion brand.</p>
        </div>
        <div class="card">
          <span class="card-badge">Campaign</span>
          <h3 class="card-title">Launch Campaign</h3>
          <p class="card-text">Launch campaign for fintech startup Series A.</p>
        </div>
      </div>
    </div>
  </section>

  <footer>
    <p>Mafyn Creative · Jakarta, Indonesia</p>
  </footer>
</BaseLayout>